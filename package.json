{
  "name": "spiderpool-mdk-worker",
  "version": "0.1.0",
  "description": "SpiderPool Bitcoin mining pool worker for Tether MDK",
  "keywords": [
    "tether",
    "mdk",
    "spiderpool",
    "minerpool"
  ],
  "author": "SpiderPool",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderPool-New/spiderpool-mdk-worker.git"
  },
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "files": [
    "index.js",
    "mdk-contract.json",
    "src/",
    "mock/",
    "config/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "setup:mdk": "npm --prefix node_modules/@tetherto/mdk install --ignore-scripts",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "mock": "node mock/server.js",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/**/*.test.js",
    "test:integration": "NODE_ENV=test brittle tests/integration/**/*.test.js",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "peerDependencies": {
    "@tetherto/mdk": "*"
  },
  "devDependencies": {
    "@hyperswarm/rpc": "3.5.0",
    "@tetherto/mdk": "github:tetherto/mdk#7f5cae88f67cd0ebedaa325778f9209135de1b8f",
    "brittle": "3.16.3",
    "fastify": "5.12.1",
    "hyperdht": "6.32.0",
    "standard": "17.1.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
